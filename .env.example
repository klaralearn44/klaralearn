# Marketing-site build variables (safe to expose in the browser)
VITE_SITE_URL=https://www.klaralearn.com
VITE_PUBLIC_API_ORIGIN=
VITE_INDEXABLE_BUILD=false

# Vercel Function runtime variables (server-only; never use the VITE_ prefix).
# Defaults to this exact allowlisted production URL when left empty.
BUBBLE_PUBLIC_TUTORS_SOURCE_URL=https://app.klaralearn.com/api/1.1/obj/publictutorcard
PUBLIC_TUTOR_MIN_RATE=0
PUBLIC_TUTOR_MAX_RATE=500

# Local API-server variables (only needed if running the optional Express
# gateway in artifacts/api-server during development)
DATABASE_URL=
SESSION_SECRET=
PUBLIC_CORS_ORIGINS=https://www.klaralearn.com,https://klaralearn.com